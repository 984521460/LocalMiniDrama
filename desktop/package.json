{
  "name": "localminidrama-desktop",
  "version": "1.2.8",
  "description": "AI漫剧工作台本地桌面客户端",
  "main": "main.js",
  "author": "LocalMiniDrama",
  "license": "MIT",
  "scripts": {
    "prestart": "npm run prepare-backend",
    "start": "electron .",
    "build:front": "cd ../frontweb && npm run build",
    "copy-front": "node scripts/copy-front.js",
    "clean:unpacked": "node scripts/clean-win-unpacked.js",
    "prepare:packaging": "node scripts/prune-optional-native.js",
    "pack": "npm run prepare-backend && npm run build:front && npm run copy-front && npm run clean:unpacked && npm run prepare:packaging && electron-builder --dir",
    "dist": "npm run prepare-backend && npm run build:front && npm run copy-front && npm run clean:unpacked && npm run prepare:packaging && electron-builder --win",
    "verify:windows-release": "node scripts/verify-windows-release.js",
    "dist:cn": "node scripts/dist-cn.js",
    "dist:mac": "bash dist-mac.sh",
    "postinstall": "node scripts/copy-backend.js && npm run prepare:packaging && electron-builder install-app-deps",
    "prepare-backend": "npm --prefix .. run build:packages && node scripts/copy-backend.js"
  },
  "dependencies": {
    "@local-mini-drama/credential-vault": "file:../packages/credential-vault",
    "@local-mini-drama/storage": "file:../packages/storage",
    "@local-mini-drama/workflow-engine": "file:../packages/workflow-engine",
    "@volcengine/openapi": "^1.36.1",
    "adm-zip": "^0.5.16",
    "ajv": "8.20.0",
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "jsonrepair": "^3.13.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.5",
    "ssh2": "1.17.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.localminidrama.desktop",
    "productName": "AI漫剧工作台",
    "artifactName": "AI漫剧工作台 ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "product-identity.js",
      "user-data-path.js",
      "windows-release-contract.js",
      "package.json",
      "backend-app/**/*",
      "node_modules/**/*",
      "schemas/**/*"
    ],
    "asarUnpack": [
      "backend-app/migrations/**",
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**"
    ],
    "extraResources": [
      {
        "from": "frontweb-dist",
        "to": "frontweb/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../example_drama",
        "to": "example_drama",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend-node/tools/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "allowElevation": false,
      "runAfterFinish": false,
      "artifactName": "AI漫剧工作台 Setup ${version}.${ext}"
    }
  }
}
