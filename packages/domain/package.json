{
  "name": "@local-mini-drama/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent domain identifiers and runtime guards for AI漫剧工作台",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:types": "tsc -p tsconfig.types.json",
    "test": "npm run build && npm run test:types && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
