{
  "name": "local-mini-drama-project",
  "version": "1.2.8",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Root engineering commands for LocalMiniDrama",
  "scripts": {
    "build:log-directory-lease": "node scripts/build-log-directory-lease.mjs",
    "licenses:check": "node --test licenses/*.test.mjs && node licenses/collect-direct-npm-licenses.mjs",
    "benchmark:source:check": "node scripts/validate-mvp-benchmark-source.js",
    "benchmark:workspace": "node scripts/mvp-benchmark-workspace.js",
    "install:workspace": "npm ci --ignore-scripts",
    "install:backend": "npm --prefix backend-node ci",
    "install:frontend": "npm --prefix frontweb ci",
    "install:desktop": "npm --prefix desktop ci",
    "install:all": "npm run install:workspace && npm run install:backend && npm run install:frontend && npm run install:desktop",
    "migrate": "npm --prefix backend-node run migrate",
    "dev:backend": "npm --prefix backend-node run dev",
    "dev:frontend": "npm --prefix frontweb run dev",
    "test:backend": "node scripts/run-node-tests.mjs backend-node all",
    "test:frontend": "node scripts/run-node-tests.mjs frontweb all",
    "test:desktop": "node scripts/run-node-tests.mjs desktop all",
    "test:domain": "npm --workspace @local-mini-drama/domain test",
    "test:storage": "npm --workspace @local-mini-drama/storage test",
    "test:credential-vault": "npm --workspace @local-mini-drama/credential-vault test",
    "test:workflow-engine": "npm --workspace @local-mini-drama/workflow-engine test",
    "test:packages": "npm run test:domain && npm run test:storage && npm run test:credential-vault && npm run test:workflow-engine",
    "pretest": "npm run build:log-directory-lease",
    "test": "npm run test:packages && npm run test:backend && npm run test:frontend && npm run test:desktop",
    "pretest:unit": "npm run build:log-directory-lease",
    "test:unit": "npm run test:packages && node scripts/run-node-tests.mjs backend-node unit && node scripts/run-node-tests.mjs frontweb unit && node scripts/run-node-tests.mjs desktop unit",
    "pretest:integration": "npm run build:log-directory-lease",
    "test:integration": "node scripts/run-node-tests.mjs backend-node integration",
    "pretest:e2e": "npm run build:log-directory-lease",
    "test:e2e": "node scripts/run-node-tests.mjs backend-node e2e",
    "build:domain": "npm --workspace @local-mini-drama/domain run build",
    "build:storage": "npm --workspace @local-mini-drama/storage run build",
    "build:credential-vault": "npm --workspace @local-mini-drama/credential-vault run build",
    "build:workflow-engine": "npm --workspace @local-mini-drama/workflow-engine run build",
    "build:packages": "npm run build:domain && npm run build:storage && npm run build:credential-vault && npm run build:workflow-engine",
    "build:frontend": "npm --prefix frontweb run build",
    "build": "npm run build:log-directory-lease && npm run build:packages && npm run build:frontend",
    "pack:windows": "npm --prefix desktop run pack",
    "pack:win": "npm run pack:windows",
    "dist:windows": "npm --prefix desktop run dist",
    "verify:mvp": "npm run benchmark:source:check && npm run licenses:check && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build",
    "verify": "npm run verify:mvp"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@10.9.8"
}
