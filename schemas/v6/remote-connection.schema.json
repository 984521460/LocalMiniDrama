{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v6/remote-connection.schema.json",
  "title": "Remote Connection Public Record",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "authMethod": { "const": "password" } } },
      "then": { "properties": { "credentialKind": { "const": "ssh_password" } } },
      "else": { "properties": { "credentialKind": { "const": "ssh_private_key" } } }
    }
  ],
  "required": [
    "uid",
    "name",
    "host",
    "port",
    "username",
    "hostFingerprint",
    "status",
    "createdAt",
    "updatedAt",
    "authMethod",
    "comfyHost",
    "comfyPort",
    "remoteWorkDir",
    "environmentReport",
    "environmentCheckedAtEpochMs",
    "stateVersion",
    "connectionEvidenceSha256",
    "credentialKind",
    "credentialConfigured"
  ],
  "properties": {
    "uid": { "$ref": "#/$defs/uid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000]+$" },
    "host": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[^\\s\\u0000/@\\\\?#\\[\\]]+$" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "username": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "hostFingerprint": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" }
      ]
    },
    "status": { "enum": ["unverified", "ready", "changed", "disabled", "error"] },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "authMethod": { "enum": ["password", "publickey"] },
    "comfyHost": { "const": "127.0.0.1" },
    "comfyPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "remoteWorkDir": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "environmentReport": { "type": "null" },
    "environmentCheckedAtEpochMs": { "type": "null" },
    "stateVersion": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "connectionEvidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "credentialKind": { "enum": ["ssh_password", "ssh_private_key"] },
    "credentialConfigured": { "type": "boolean" }
  },
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
