{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.example/schemas/v5/character-candidate-batch.schema.json",
  "title": "CharacterCandidateBatchV5",
  "$comment": "The runtime contract additionally requires ordinal order and unique candidate UID, asset version UID, logical URI, and content hash values across all four records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchUid", "characterUid", "requestSha256", "request", "candidates"],
  "properties": {
    "schemaVersion": {"const": "5.0"},
    "batchUid": {"$ref": "#/$defs/uid"},
    "characterUid": {"$ref": "#/$defs/uid"},
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "request": {"$ref": "#/$defs/request"},
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "batchUid",
        "characterUid",
        "promptSemanticUid",
        "profileUid",
        "manifestUid",
        "width",
        "height",
        "seed",
        "candidateCount"
      ],
      "properties": {
        "schemaVersion": {"const": "5.0"},
        "batchUid": {"$ref": "#/$defs/uid"},
        "characterUid": {"$ref": "#/$defs/uid"},
        "promptSemanticUid": {"$ref": "#/$defs/uid"},
        "profileUid": {"$ref": "#/$defs/uid"},
        "manifestUid": {"$ref": "#/$defs/uid"},
        "width": {"type": "integer", "minimum": 64, "maximum": 8192},
        "height": {"type": "integer", "minimum": 64, "maximum": 8192},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "candidateCount": {"const": 4}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "ordinal",
        "assetVersionUid",
        "logicalUri",
        "mediaType",
        "width",
        "height",
        "contentSha256",
        "presentation"
      ],
      "properties": {
        "uid": {"$ref": "#/$defs/uid"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 3},
        "assetVersionUid": {"$ref": "#/$defs/uid"},
        "logicalUri": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^asset://characters/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/candidate-batches/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-3]$"
        },
        "mediaType": {"enum": ["image/png", "image/jpeg", "image/webp"]},
        "width": {"type": "integer", "minimum": 64, "maximum": 8192},
        "height": {"type": "integer", "minimum": 64, "maximum": 8192},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "presentation": {"const": "single_portrait"}
      }
    }
  }
}
