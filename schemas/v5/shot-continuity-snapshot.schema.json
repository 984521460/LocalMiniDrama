{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v5/shot-continuity-snapshot.schema.json",
  "title": "Shot continuity snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "snapshotUid", "dramaUid", "shotResultUid", "shotResultHash",
    "shotEnvelopeHash", "shotApprovalRef", "shotId", "shotOrdinal", "scene",
    "characters", "props", "createdAtEpochMs"
  ],
  "properties": {
    "schemaVersion": { "const": "5.0" },
    "snapshotUid": { "$ref": "#/$defs/uid" },
    "dramaUid": { "$ref": "#/$defs/uid" },
    "shotResultUid": { "$ref": "#/$defs/uid" },
    "shotResultHash": { "$ref": "#/$defs/sha256" },
    "shotEnvelopeHash": { "$ref": "#/$defs/sha256" },
    "shotApprovalRef": {
      "type": "string",
      "pattern": "^review:v1:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "shotId": { "$ref": "#/$defs/identifier" },
    "shotOrdinal": { "type": "integer", "minimum": 1, "maximum": 6 },
    "scene": { "$ref": "#/$defs/scene" },
    "characters": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/character" }
    },
    "props": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/prop" }
    },
    "createdAtEpochMs": { "type": "integer", "minimum": 0, "maximum": 253402300799999 }
  },
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "colors": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneUid", "versionUid", "name", "visualDescription", "lighting", "colorAnchors"],
      "properties": {
        "sceneUid": { "$ref": "#/$defs/uid" },
        "versionUid": { "$ref": "#/$defs/uid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "visualDescription": { "$ref": "#/$defs/boundedText" },
        "lighting": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "colorAnchors": { "$ref": "#/$defs/colors" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factRef", "characterUid", "referencePackageUid", "identityVersionUid", "costumeVersionUid"],
      "properties": {
        "factRef": { "$ref": "#/$defs/identifier" },
        "characterUid": { "$ref": "#/$defs/uid" },
        "referencePackageUid": { "$ref": "#/$defs/uid" },
        "identityVersionUid": { "$ref": "#/$defs/uid" },
        "costumeVersionUid": { "$ref": "#/$defs/uid" }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factRef", "propUid", "versionUid", "name", "visualDescription", "colorAnchors"],
      "properties": {
        "factRef": { "$ref": "#/$defs/identifier" },
        "propUid": { "$ref": "#/$defs/uid" },
        "versionUid": { "$ref": "#/$defs/uid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "visualDescription": { "$ref": "#/$defs/boundedText" },
        "colorAnchors": { "$ref": "#/$defs/colors" }
      }
    }
  }
}
