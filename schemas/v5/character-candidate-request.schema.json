{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.example/schemas/v5/character-candidate-request.schema.json",
  "title": "CharacterCandidateRequestV5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchUid",
    "characterUid",
    "promptSemanticUid",
    "profileUid",
    "manifestUid",
    "width",
    "height",
    "seed",
    "candidateCount"
  ],
  "properties": {
    "schemaVersion": {"const": "5.0"},
    "batchUid": {"$ref": "#/$defs/uid"},
    "characterUid": {"$ref": "#/$defs/uid"},
    "promptSemanticUid": {"$ref": "#/$defs/uid"},
    "profileUid": {"$ref": "#/$defs/uid"},
    "manifestUid": {"$ref": "#/$defs/uid"},
    "width": {"type": "integer", "minimum": 64, "maximum": 8192},
    "height": {"type": "integer", "minimum": 64, "maximum": 8192},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "candidateCount": {"const": 4}
  },
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
