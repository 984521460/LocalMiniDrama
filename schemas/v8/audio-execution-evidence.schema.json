{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v8/audio-execution-evidence.schema.json",
  "title": "AudioExecutionEvidence v8",
  "$comment": "Runtime requires exact order and identity equality with the referenced AudioModePlan, validates every ready AssetVersion evidence record, and recomputes executionSha256. Schema covers the standalone shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "uid", "planUid", "planSha256", "mode", "h3NativeSource",
    "ttsOutputs", "executionSha256", "createdAtEpochMs"
  ],
  "properties": {
    "schemaVersion": { "const": "8.0" },
    "uid": { "$ref": "#/$defs/uid" },
    "planUid": { "$ref": "#/$defs/uid" },
    "planSha256": { "$ref": "#/$defs/sha256" },
    "mode": { "enum": ["independent_tts", "h3_native", "hybrid"] },
    "h3NativeSource": {
      "oneOf": [{ "$ref": "#/$defs/h3NativeSource" }, { "type": "null" }]
    },
    "ttsOutputs": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/ttsOutput" }
    },
    "executionSha256": { "$ref": "#/$defs/sha256" },
    "createdAtEpochMs": { "$ref": "#/$defs/epoch" }
  },
  "allOf": [
    {
      "type": "object",
      "if": { "type": "object", "properties": { "mode": { "const": "independent_tts" } }, "required": ["mode"] },
      "then": { "type": "object", "properties": { "ttsOutputs": { "type": "array", "minItems": 1 }, "h3NativeSource": { "type": "null" } } }
    },
    {
      "type": "object",
      "if": { "type": "object", "properties": { "mode": { "const": "h3_native" } }, "required": ["mode"] },
      "then": { "type": "object", "properties": { "ttsOutputs": { "type": "array", "maxItems": 0 }, "h3NativeSource": { "$ref": "#/$defs/h3NativeSource" } } }
    },
    {
      "type": "object",
      "if": { "type": "object", "properties": { "mode": { "const": "hybrid" } }, "required": ["mode"] },
      "then": { "type": "object", "properties": { "ttsOutputs": { "type": "array", "minItems": 1 }, "h3NativeSource": { "$ref": "#/$defs/h3NativeSource" } } }
    }
  ],
  "$defs": {
    "uid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "epoch": { "type": "integer", "minimum": 0, "maximum": 253402300799999 },
    "ttsOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogueDeliveryUid", "requestSha256", "audioAsset", "audioVersionEvidence"],
      "properties": {
        "dialogueDeliveryUid": { "$ref": "#/$defs/uid" },
        "requestSha256": { "$ref": "#/$defs/sha256" },
        "audioAsset": { "$ref": "#/$defs/audioAssetEvidence" },
        "audioVersionEvidence": { "$ref": "#/$defs/audioVersionEvidence" }
      }
    },
    "assetOwnershipEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid", "ownerType", "ownerUid", "assetType", "currentVersionUid",
        "status", "createdAt", "updatedAt"
      ],
      "properties": {
        "uid": { "$ref": "#/$defs/uid" },
        "ownerType": { "const": "drama" },
        "ownerUid": { "$ref": "#/$defs/uid" },
        "assetType": { "type": "string" },
        "currentVersionUid": { "$ref": "#/$defs/uid" },
        "status": { "const": "ready" },
        "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "minLength": 24, "maxLength": 24 },
        "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "minLength": 24, "maxLength": 24 }
      }
    },
    "audioAssetEvidence": {
      "allOf": [
        { "$ref": "#/$defs/assetOwnershipEvidence" },
        { "type": "object", "properties": { "assetType": { "const": "audio" } } }
      ]
    },
    "videoAssetEvidence": {
      "allOf": [
        { "$ref": "#/$defs/assetOwnershipEvidence" },
        { "type": "object", "properties": { "assetType": { "const": "video" } } }
      ]
    },
    "assetEvidenceCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid", "assetUid", "storageProvider", "logicalUri", "relativePath", "sha256",
        "mimeType", "width", "height", "durationMs", "parentUid", "status", "createdAt"
      ],
      "properties": {
        "uid": { "$ref": "#/$defs/uid" },
        "assetUid": { "$ref": "#/$defs/uid" },
        "storageProvider": { "enum": ["local", "nas", "object"] },
        "logicalUri": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^asset://[A-Za-z0-9][^\\u0000-\\u0020\\u007f\\\\]*$" },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*//)(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))(?!.*[\\\\/]$)(?!\\s)(?!.*\\s$)[^\\u0000]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 255 },
        "width": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "height": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "durationMs": { "type": "integer", "minimum": 1 },
        "parentUid": { "oneOf": [{ "$ref": "#/$defs/uid" }, { "type": "null" }] },
        "status": { "const": "ready" },
        "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "minLength": 24, "maxLength": 24 }
      }
    },
    "audioVersionEvidence": {
      "allOf": [
        { "$ref": "#/$defs/assetEvidenceCore" },
        {
          "type": "object",
          "properties": {
            "mimeType": { "enum": ["audio/aac", "audio/flac", "audio/mpeg", "audio/wav", "audio/x-wav"] },
            "width": { "type": "null" },
            "height": { "type": "null" },
            "durationMs": { "type": "integer", "minimum": 1, "maximum": 600000 }
          }
        }
      ]
    },
    "videoVersionEvidence": {
      "allOf": [
        { "$ref": "#/$defs/assetEvidenceCore" },
        {
          "type": "object",
          "properties": {
            "mimeType": { "const": "video/mp4" },
            "width": { "type": "integer", "minimum": 32, "maximum": 1344, "multipleOf": 32 },
            "height": { "type": "integer", "minimum": 32, "maximum": 1344, "multipleOf": 32 },
            "durationMs": { "type": "integer", "minimum": 1, "maximum": 20000 }
          }
        }
      ]
    },
    "h3NativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generationHistoryUid", "generationSpec", "videoEvidence",
        "generationSpecSha256", "videoEvidenceSha256", "videoAsset",
        "videoVersionEvidence", "audioCodec", "audioStreams", "durationMs", "sourceSha256"
      ],
      "properties": {
        "generationHistoryUid": { "$ref": "#/$defs/uid" },
        "generationSpec": { "$ref": "https://local-mini-drama.invalid/schemas/v7/h3-generation-spec.schema.json" },
        "videoEvidence": { "$ref": "https://local-mini-drama.invalid/schemas/v7/h3-video-evidence.schema.json" },
        "generationSpecSha256": { "$ref": "#/$defs/sha256" },
        "videoEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "videoAsset": { "$ref": "#/$defs/videoAssetEvidence" },
        "videoVersionEvidence": { "$ref": "#/$defs/videoVersionEvidence" },
        "audioCodec": { "const": "aac" },
        "audioStreams": { "const": 1 },
        "durationMs": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
