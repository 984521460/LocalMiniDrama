{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v8/audio-mix-plan.schema.json",
  "title": "Deterministic audio mix plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "algorithmVersion", "uid", "dramaUid", "workflowRunUid",
    "timelineUid", "timelineSha256", "mode", "durationMs", "dialogueGainMilliDb",
    "nativeGainMilliDb", "bgm", "ducking", "mixSha256", "createdAtEpochMs"
  ],
  "properties": {
    "schemaVersion": { "const": "audio-mix-plan.v1" },
    "algorithmVersion": { "const": "audio-ducking-ms.v1" },
    "uid": { "$ref": "#/$defs/uid" },
    "dramaUid": { "$ref": "#/$defs/uid" },
    "workflowRunUid": { "$ref": "#/$defs/uid" },
    "timelineUid": { "$ref": "#/$defs/uid" },
    "timelineSha256": { "$ref": "#/$defs/sha256" },
    "mode": { "enum": ["independent_tts", "h3_native", "hybrid"] },
    "durationMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "dialogueGainMilliDb": {
      "oneOf": [
        { "type": "integer", "minimum": -24000, "maximum": 12000 },
        { "type": "null" }
      ]
    },
    "nativeGainMilliDb": {
      "oneOf": [
        { "type": "integer", "minimum": -60000, "maximum": 12000 },
        { "type": "null" }
      ]
    },
    "bgm": { "$ref": "#/$defs/bgm" },
    "ducking": { "$ref": "#/$defs/ducking" },
    "mixSha256": { "$ref": "#/$defs/sha256" },
    "createdAtEpochMs": { "type": "integer", "minimum": 0, "maximum": 253402300799999 }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "independent_tts" } }, "required": ["mode"] },
      "then": { "properties": { "nativeGainMilliDb": { "type": "null" } } },
      "else": { "properties": { "nativeGainMilliDb": { "type": "integer", "minimum": -60000, "maximum": 12000 } } }
    },
    {
      "if": { "properties": { "mode": { "const": "h3_native" } }, "required": ["mode"] },
      "then": { "properties": { "dialogueGainMilliDb": { "type": "null" } } },
      "else": { "properties": { "dialogueGainMilliDb": { "type": "integer", "minimum": -24000, "maximum": 12000 } } }
    }
  ],
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bgm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackUid", "licenseUid", "assetUid", "assetVersionUid", "mediaSha256",
        "mimeType", "sourceDurationMs", "loopCount", "baseGainMilliDb",
        "duckedGainMilliDb", "fadeInMs", "fadeOutMs"
      ],
      "properties": {
        "trackUid": { "$ref": "#/$defs/uid" },
        "licenseUid": { "$ref": "#/$defs/uid" },
        "assetUid": { "$ref": "#/$defs/uid" },
        "assetVersionUid": { "$ref": "#/$defs/uid" },
        "mediaSha256": { "$ref": "#/$defs/sha256" },
        "mimeType": { "enum": ["audio/aac", "audio/flac", "audio/mpeg", "audio/wav", "audio/x-wav"] },
        "sourceDurationMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "loopCount": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "baseGainMilliDb": { "type": "integer", "minimum": -30000, "maximum": 0 },
        "duckedGainMilliDb": { "type": "integer", "minimum": -60000, "maximum": -3000 },
        "fadeInMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "fadeOutMs": { "type": "integer", "minimum": 0, "maximum": 30000 }
      }
    },
    "ducking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attackMs", "releaseMs", "windows"],
      "properties": {
        "attackMs": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "releaseMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "windows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/window" }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMs", "endMs", "gainMilliDb"],
      "properties": {
        "startMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "endMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "gainMilliDb": { "type": "integer", "minimum": -60000, "maximum": -3000 }
      }
    }
  },
  "$comment": "Runtime derives and merges every ducking window from a trusted AudioTimeline, requires an export-eligible same-drama BGM track, binds all source identities and hashes, validates cross-field gain/fade/loop bounds, and grants execution trust only after replaying an external immutable envelope keyed by the expected mix-plan UID. Paths, URLs and credential references are deliberately absent."
}
