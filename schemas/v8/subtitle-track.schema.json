{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v8/subtitle-track.schema.json",
  "title": "SubtitleTrack v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "timingAlgorithmVersion", "timelineUid", "planUid",
    "executionUid", "durationMs", "cues", "trackSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "8.0" },
    "timingAlgorithmVersion": {
      "enum": ["audio-timeline-ms.v1", "audio-timeline-ms.v2", "audio-timeline-ms.v3"]
    },
    "timelineUid": { "$ref": "dialogue-delivery.schema.json#/$defs/uid" },
    "planUid": { "$ref": "dialogue-delivery.schema.json#/$defs/uid" },
    "executionUid": { "$ref": "dialogue-delivery.schema.json#/$defs/uid" },
    "durationMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/cue" }
    },
    "trackSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "dialogueDeliveryUid", "dialogueEntryId", "characterUid",
        "startMs", "endMs", "text", "textSha256", "sourceKind",
        "sourceAssetVersionUid", "sourceMediaSha256"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 999 },
        "dialogueDeliveryUid": { "$ref": "dialogue-delivery.schema.json#/$defs/uid" },
        "dialogueEntryId": { "$ref": "dialogue-delivery.schema.json#/$defs/sourceId" },
        "characterUid": { "$ref": "dialogue-delivery.schema.json#/$defs/uid" },
        "startMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "endMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "text": { "$ref": "dialogue-delivery.schema.json#/properties/text" },
        "textSha256": { "$ref": "#/$defs/sha256" },
        "sourceKind": { "type": "string", "enum": ["tts_asset", "h3_native"] },
        "sourceAssetVersionUid": { "$ref": "dialogue-delivery.schema.json#/$defs/uid" },
        "sourceMediaSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$comment": "Runtime requires dense ordered cues, exact integer-millisecond boundaries, no overlap, exact equality with the parent audio segments and recomputed text and track hashes."
}
