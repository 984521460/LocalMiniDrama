{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v8/production-timeline-snapshot.schema.json",
  "title": "Immutable production timeline snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "algorithmVersion", "uid", "dramaUid", "workflowRunUid",
    "durationMs", "shots", "audioTimeline", "audioSources", "subtitleTrack",
    "audioMixPlan", "bgmTrack", "snapshotSha256", "createdAtEpochMs"
  ],
  "properties": {
    "schemaVersion": { "const": "production-timeline-snapshot.v1" },
    "algorithmVersion": { "const": "production-timeline-ms.v1" },
    "uid": { "$ref": "#/$defs/uid" },
    "dramaUid": { "$ref": "#/$defs/uid" },
    "workflowRunUid": { "$ref": "#/$defs/uid" },
    "durationMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/shot" }
    },
    "audioTimeline": { "$ref": "audio-timeline.schema.json" },
    "audioSources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/audioSource" }
    },
    "subtitleTrack": { "$ref": "subtitle-track.schema.json" },
    "audioMixPlan": { "$ref": "audio-mix-plan.schema.json" },
    "bgmTrack": { "$ref": "bgm-track.schema.json" },
    "snapshotSha256": { "$ref": "#/$defs/sha256" },
    "createdAtEpochMs": { "type": "integer", "minimum": 0, "maximum": 253402300799999 }
  },
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid", "ownerType", "ownerUid", "assetType", "currentVersionUid",
        "status", "createdAt", "updatedAt"
      ],
      "properties": {
        "uid": { "$ref": "#/$defs/uid" },
        "ownerType": { "const": "drama" },
        "ownerUid": { "$ref": "#/$defs/uid" },
        "assetType": { "enum": ["audio", "video"] },
        "currentVersionUid": { "$ref": "#/$defs/uid" },
        "status": { "const": "ready" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "assetVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid", "assetUid", "storageProvider", "logicalUri", "relativePath",
        "sha256", "mimeType", "width", "height", "durationMs", "parentUid",
        "status", "createdAt"
      ],
      "properties": {
        "uid": { "$ref": "#/$defs/uid" },
        "assetUid": { "$ref": "#/$defs/uid" },
        "storageProvider": { "enum": ["local", "nas", "object"] },
        "logicalUri": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^asset://[A-Za-z0-9]"
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mimeType": {
          "enum": ["audio/aac", "audio/flac", "audio/mpeg", "audio/wav", "audio/x-wav", "video/mp4"]
        },
        "width": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "height": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "durationMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "parentUid": { "oneOf": [{ "$ref": "#/$defs/uid" }, { "type": "null" }] },
        "status": { "const": "ready" },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "shotId", "plannedOrdinal", "h3ExecutionResult", "generationHistory", "startMs",
        "endMs", "durationMs", "asset", "assetVersion"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 999 },
        "shotId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "plannedOrdinal": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "h3ExecutionResult": { "$ref": "#/$defs/h3ExecutionResult" },
        "generationHistory": { "$ref": "#/$defs/generationHistoryEvidence" },
        "startMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "endMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "durationMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "asset": {
          "allOf": [
            { "$ref": "#/$defs/asset" },
            { "properties": { "assetType": { "const": "video" } } }
          ]
        },
        "assetVersion": {
          "allOf": [
            { "$ref": "#/$defs/assetVersion" },
            {
              "properties": {
                "mimeType": { "const": "video/mp4" },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        }
      }
    },
    "h3ExecutionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "taskUid", "taskStateVersion", "workflowRunUid",
        "generationRunUid", "historyUid", "assetUid", "assetVersionUid",
        "nodeRunUid", "status"
      ],
      "properties": {
        "schemaVersion": { "const": "h3-local-execution-result.v2" },
        "taskUid": { "$ref": "#/$defs/uid" },
        "taskStateVersion": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "workflowRunUid": { "$ref": "#/$defs/uid" },
        "generationRunUid": { "$ref": "#/$defs/uid" },
        "historyUid": { "$ref": "#/$defs/uid" },
        "assetUid": { "$ref": "#/$defs/uid" },
        "assetVersionUid": { "$ref": "#/$defs/uid" },
        "nodeRunUid": { "$ref": "#/$defs/uid" },
        "status": { "const": "succeeded" }
      }
    },
    "generationHistoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "uid", "runUid", "dramaUid", "assetUid", "status",
        "outputVersionUid", "outputVersionEvidence", "createdAtEpochMs",
        "completedAtEpochMs"
      ],
      "properties": {
        "schemaVersion": { "const": "generation-history-output-evidence.v1" },
        "uid": { "$ref": "#/$defs/uid" },
        "runUid": { "$ref": "#/$defs/uid" },
        "dramaUid": { "$ref": "#/$defs/uid" },
        "assetUid": { "$ref": "#/$defs/uid" },
        "status": { "const": "succeeded" },
        "outputVersionUid": { "$ref": "#/$defs/uid" },
        "outputVersionEvidence": {
          "allOf": [
            { "$ref": "#/$defs/assetVersion" },
            {
              "properties": {
                "mimeType": { "const": "video/mp4" },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "createdAtEpochMs": { "type": "integer", "minimum": 0, "maximum": 253402300799999 },
        "completedAtEpochMs": { "type": "integer", "minimum": 0, "maximum": 253402300799999 }
      }
    },
    "audioSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "asset", "assetVersion"],
      "properties": {
        "sourceKind": { "enum": ["tts_asset", "h3_native"] },
        "asset": { "$ref": "#/$defs/asset" },
        "assetVersion": { "$ref": "#/$defs/assetVersion" }
      },
      "allOf": [
        {
          "if": { "properties": { "sourceKind": { "const": "tts_asset" } }, "required": ["sourceKind"] },
          "then": {
            "properties": {
              "asset": { "properties": { "assetType": { "const": "audio" } } },
              "assetVersion": {
                "properties": {
                  "mimeType": { "enum": ["audio/aac", "audio/flac", "audio/mpeg", "audio/wav", "audio/x-wav"] },
                  "width": { "type": "null" },
                  "height": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "sourceKind": { "const": "h3_native" } }, "required": ["sourceKind"] },
          "then": {
            "properties": {
              "asset": { "properties": { "assetType": { "const": "video" } } },
              "assetVersion": {
                "properties": {
                  "mimeType": { "const": "video/mp4" },
                  "width": { "type": "integer", "minimum": 1 },
                  "height": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "Runtime requires trusted AudioTimeline and AudioMixPlan instances, freezes exact portable AssetVersion evidence for every ordered video clip and unique audio source, binds each shot to a trusted succeeded H3 local execution result and its distinct GenerationHistory run, binds the subtitle and export-eligible BGM records, checks same-drama ownership, cumulative integer-millisecond continuity, uniqueness and full cross-plan identities, and grants execution trust only after replaying an external immutable envelope keyed by the expected snapshot UID plus authoritative H3 execution and GenerationHistory loaders. Reordering therefore creates a distinct snapshot instead of mutating prior evidence."
}
