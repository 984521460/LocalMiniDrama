{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v2/project-archive-manifest-v2.1.schema.json",
  "title": "LocalMiniDrama project archive manifest v2.1",
  "$comment": "Exact row semantics, canonical JSON, cross-record ownership, hashes, portable binding closure, media bytes, and project isolation are additionally enforced by parseProjectManifestV21/validateProjectArchiveV21Bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "archiveKind", "legacyProjectVersion", "exportedAt", "project",
    "records", "structuredRecords", "legacyRecords", "mediaBindings", "portableBindings"
  ],
  "properties": {
    "schemaVersion": { "const": "2.1.0" },
    "archiveKind": { "const": "local-mini-drama-project" },
    "legacyProjectVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "exportedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "project": {
      "$ref": "https://local-mini-drama.invalid/schemas/v2/project-archive-manifest.schema.json#/$defs/project"
    },
    "records": {
      "$ref": "https://local-mini-drama.invalid/schemas/v2/project-archive-manifest.schema.json#/$defs/records"
    },
    "structuredRecords": { "$ref": "#/$defs/structuredRecords" },
    "legacyRecords": { "$ref": "#/$defs/legacyRecords" },
    "mediaBindings": {
      "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/mediaBinding" }
    },
    "portableBindings": {
      "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/portableBinding" }
    }
  },
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recordRows": {
      "type": "array", "maxItems": 100000,
      "items": { "type": "object" }
    },
    "characterCandidateExecutionRows": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_uid", "drama_uid", "character_uid", "source_selection_uid",
          "extraction_result_uid", "extraction_result_hash", "extraction_envelope_hash",
          "extraction_review_uid", "request_json", "request_sha256", "source_json",
          "source_sha256", "profile_json", "profile_sha256", "manifest_json",
          "manifest_sha256", "state", "batch_uid", "error_code",
          "created_at_epoch_ms", "updated_at_epoch_ms"
        ],
        "properties": {
          "operation_uid": { "$ref": "#/$defs/uid" },
          "drama_uid": { "$ref": "#/$defs/uid" },
          "character_uid": { "$ref": "#/$defs/uid" },
          "source_selection_uid": { "$ref": "#/$defs/uid" },
          "extraction_result_uid": { "$ref": "#/$defs/uid" },
          "extraction_result_hash": { "$ref": "#/$defs/sha256" },
          "extraction_envelope_hash": { "$ref": "#/$defs/sha256" },
          "extraction_review_uid": { "$ref": "#/$defs/uid" },
          "request_json": { "type": "string", "minLength": 2, "maxLength": 16384 },
          "request_sha256": { "$ref": "#/$defs/sha256" },
          "source_json": { "type": "string", "minLength": 2, "maxLength": 65536 },
          "source_sha256": { "$ref": "#/$defs/sha256" },
          "profile_json": { "type": "string", "minLength": 2, "maxLength": 4096 },
          "profile_sha256": { "$ref": "#/$defs/sha256" },
          "manifest_json": { "type": "string", "minLength": 2, "maxLength": 4096 },
          "manifest_sha256": { "$ref": "#/$defs/sha256" },
          "state": { "enum": ["reserved", "succeeded", "failed", "submission_unknown"] },
          "batch_uid": { "oneOf": [{ "$ref": "#/$defs/uid" }, { "type": "null" }] },
          "error_code": {
            "oneOf": [
              { "enum": [
                "CHARACTER_CANDIDATE_EXECUTION_OUTPUT_INVALID",
                "CHARACTER_CANDIDATE_EXECUTION_SOURCE_STALE",
                "CHARACTER_CANDIDATE_EXECUTION_SUBMISSION_UNKNOWN"
              ] },
              { "type": "null" }
            ]
          },
          "created_at_epoch_ms": { "type": "integer", "minimum": 0, "maximum": 253402300799999 },
          "updated_at_epoch_ms": { "type": "integer", "minimum": 0, "maximum": 253402300799999 }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "succeeded" } }, "required": ["state"] },
            "then": {
              "properties": {
                "batch_uid": { "$ref": "#/$defs/uid" },
                "error_code": { "type": "null" }
              }
            }
          },
          {
            "if": { "properties": { "state": { "const": "reserved" } }, "required": ["state"] },
            "then": {
              "properties": {
                "batch_uid": { "type": "null" },
                "error_code": { "type": "null" }
              }
            }
          },
          {
            "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
            "then": {
              "properties": {
                "batch_uid": { "type": "null" },
                "error_code": {
                  "enum": [
                    "CHARACTER_CANDIDATE_EXECUTION_OUTPUT_INVALID",
                    "CHARACTER_CANDIDATE_EXECUTION_SOURCE_STALE"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": { "state": { "const": "submission_unknown" } },
              "required": ["state"]
            },
            "then": {
              "properties": {
                "batch_uid": { "type": "null" },
                "error_code": { "const": "CHARACTER_CANDIDATE_EXECUTION_SUBMISSION_UNKNOWN" }
              }
            }
          }
        ]
      }
    },
    "characterCandidateExecutionItemRows": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_uid", "ordinal", "seed", "prompt_sha256", "provider", "model",
          "parameters_json", "parameters_sha256", "candidate_uid", "asset_uid",
          "asset_version_uid", "logical_uri", "relative_path", "content_sha256",
          "byte_length", "width", "height", "created_at_epoch_ms"
        ],
        "properties": {
          "operation_uid": { "$ref": "#/$defs/uid" },
          "ordinal": { "type": "integer", "minimum": 0, "maximum": 3 },
          "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "prompt_sha256": { "$ref": "#/$defs/sha256" },
          "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "model": { "type": "string", "minLength": 1, "maxLength": 128 },
          "parameters_json": { "type": "string", "minLength": 2, "maxLength": 4096 },
          "parameters_sha256": { "$ref": "#/$defs/sha256" },
          "candidate_uid": { "$ref": "#/$defs/uid" },
          "asset_uid": { "$ref": "#/$defs/uid" },
          "asset_version_uid": { "$ref": "#/$defs/uid" },
          "logical_uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+$", "maxLength": 2048 },
          "content_sha256": { "$ref": "#/$defs/sha256" },
          "byte_length": { "type": "integer", "minimum": 1, "maximum": 16777216 },
          "width": { "type": "integer", "minimum": 256, "maximum": 2048 },
          "height": { "type": "integer", "minimum": 256, "maximum": 2048 },
          "created_at_epoch_ms": { "type": "integer", "minimum": 0, "maximum": 253402300799999 }
        }
      }
    },
    "structuredRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrativeResults", "narrativeReviewEvents", "narrativeStaleEvents",
        "characterIdentityVersions", "characterAppearanceVersions", "characterCostumeVersions",
        "characterVoiceVersions", "sceneVersions", "propVersions", "characterCandidateBatches",
        "characterCandidateResults", "characterIdentityLockEvents", "characterReferencePackages",
        "characterReferencePackageItems", "shotContinuitySnapshots",
        "shotContinuityCharacterRefs", "shotContinuityPropRefs", "voiceProfiles",
        "voiceProfileSelectionEvents", "bgmLicenses", "bgmTracks"
      ],
      "dependentRequired": {
        "characterCandidateExecutions": ["characterCandidateExecutionItems"],
        "characterCandidateExecutionItems": ["characterCandidateExecutions"]
      },
      "properties": {
        "narrativeResults": { "$ref": "#/$defs/recordRows" },
        "narrativeReviewEvents": { "$ref": "#/$defs/recordRows" },
        "narrativeStaleEvents": { "$ref": "#/$defs/recordRows" },
        "characterIdentityVersions": { "$ref": "#/$defs/recordRows" },
        "characterAppearanceVersions": { "$ref": "#/$defs/recordRows" },
        "characterCostumeVersions": { "$ref": "#/$defs/recordRows" },
        "characterVoiceVersions": { "$ref": "#/$defs/recordRows" },
        "sceneVersions": { "$ref": "#/$defs/recordRows" },
        "propVersions": { "$ref": "#/$defs/recordRows" },
        "characterCandidateBatches": { "$ref": "#/$defs/recordRows" },
        "characterCandidateResults": { "$ref": "#/$defs/recordRows" },
        "characterCandidateExecutions": { "$ref": "#/$defs/characterCandidateExecutionRows" },
        "characterCandidateExecutionItems": { "$ref": "#/$defs/characterCandidateExecutionItemRows" },
        "characterIdentityLockEvents": { "$ref": "#/$defs/recordRows" },
        "characterReferencePackages": { "$ref": "#/$defs/recordRows" },
        "characterReferencePackageItems": { "$ref": "#/$defs/recordRows" },
        "characterReferencePackageExecutions": { "$ref": "#/$defs/recordRows" },
        "shotContinuitySnapshots": { "$ref": "#/$defs/recordRows" },
        "shotContinuityCharacterRefs": { "$ref": "#/$defs/recordRows" },
        "shotContinuityPropRefs": { "$ref": "#/$defs/recordRows" },
        "voiceProfiles": { "$ref": "#/$defs/recordRows" },
        "voiceProfileSelectionEvents": { "$ref": "#/$defs/recordRows" },
        "bgmLicenses": { "$ref": "#/$defs/recordRows" },
        "bgmTracks": { "$ref": "#/$defs/recordRows" }
      }
    },
    "legacyRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dramas", "episodes", "storyboards", "characters", "scenes", "props",
        "episodeCharacters", "storyboardCharacters", "storyboardProps",
        "characterLibraries", "sceneLibraries", "propLibraries", "legacyAssets",
        "framePrompts", "imageGenerations", "videoGenerations", "videoMerges"
      ],
      "properties": {
        "dramas": { "$ref": "#/$defs/recordRows" },
        "episodes": { "$ref": "#/$defs/recordRows" },
        "storyboards": { "$ref": "#/$defs/recordRows" },
        "characters": { "$ref": "#/$defs/recordRows" },
        "scenes": { "$ref": "#/$defs/recordRows" },
        "props": { "$ref": "#/$defs/recordRows" },
        "episodeCharacters": { "$ref": "#/$defs/recordRows" },
        "storyboardCharacters": { "$ref": "#/$defs/recordRows" },
        "storyboardProps": { "$ref": "#/$defs/recordRows" },
        "characterLibraries": { "$ref": "#/$defs/recordRows" },
        "sceneLibraries": { "$ref": "#/$defs/recordRows" },
        "propLibraries": { "$ref": "#/$defs/recordRows" },
        "legacyAssets": { "$ref": "#/$defs/recordRows" },
        "framePrompts": { "$ref": "#/$defs/recordRows" },
        "imageGenerations": { "$ref": "#/$defs/recordRows" },
        "videoGenerations": { "$ref": "#/$defs/recordRows" },
        "videoMerges": { "$ref": "#/$defs/recordRows" }
      }
    },
    "mediaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_version_uid", "binding_state", "archive_path", "byte_length", "sha256"],
      "properties": {
        "asset_version_uid": { "$ref": "#/$defs/uid" },
        "binding_state": { "enum": ["content_addressed", "needs_rebind", "not_required"] },
        "archive_path": {
          "oneOf": [
            { "type": "string", "pattern": "^v2/media/sha256/[0-9a-f]{2}/[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "byte_length": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 268435456 },
            { "type": "null" }
          ]
        },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "portableBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "row_uid", "column", "portable_field"],
      "properties": {
        "table": { "enum": ["canvas_nodes", "workflow_runs", "node_runs", "voice_profiles"] },
        "row_uid": { "$ref": "#/$defs/uid" },
        "column": {
          "enum": [
            "config_json", "graph_snapshot_json", "input_snapshot_json", "output_json",
            "credential_ref"
          ]
        },
        "portable_field": { "$ref": "#/$defs/portableField" }
      }
    },
    "portableField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "binding_state", "marker_count", "portable_value"],
      "properties": {
        "schema_version": { "const": "project-archive-portable-field.v1" },
        "binding_state": { "enum": ["needs_rebind", "not_required"] },
        "marker_count": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "portable_value": {
          "oneOf": [
            { "type": "object" }, { "type": "array" }, { "type": "string" },
            { "type": "number" }, { "type": "boolean" }, { "type": "null" }
          ]
        }
      }
    }
  }
}
