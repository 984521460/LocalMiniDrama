{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v9/narrative-adaptation-comparison.schema.json",
  "title": "Narrative source facts and adaptation comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "dramaUid", "sourceResultUid", "sourceResultHash",
    "sourceEnvelopeHash", "sourceApprovalRef", "adaptationResultUid",
    "adaptationResultHash", "adaptationEnvelopeHash", "adaptationStatus",
    "sourceDocumentUid", "sourceDocumentSha256", "sourceSelectionUid",
    "selectedTextSha256", "durationSummary", "sourceFacts", "beats",
    "adaptationDecisions"
  ],
  "properties": {
    "schemaVersion": { "const": "narrative-adaptation-comparison.v1" },
    "dramaUid": { "$ref": "#/$defs/uuid" },
    "sourceResultUid": { "$ref": "#/$defs/uuid" },
    "sourceResultHash": { "$ref": "#/$defs/sha256" },
    "sourceEnvelopeHash": { "$ref": "#/$defs/sha256" },
    "sourceApprovalRef": { "$ref": "#/$defs/reviewRef" },
    "adaptationResultUid": { "$ref": "#/$defs/uuid" },
    "adaptationResultHash": { "$ref": "#/$defs/sha256" },
    "adaptationEnvelopeHash": { "$ref": "#/$defs/sha256" },
    "adaptationStatus": { "enum": ["pending_review", "approved", "rejected", "stale"] },
    "sourceDocumentUid": { "$ref": "#/$defs/uuid" },
    "sourceDocumentSha256": { "$ref": "#/$defs/sha256" },
    "sourceSelectionUid": { "$ref": "#/$defs/uuid" },
    "selectedTextSha256": { "$ref": "#/$defs/sha256" },
    "durationSummary": { "$ref": "#/$defs/durationSummary" },
    "sourceFacts": {
      "type": "array",
      "maxItems": 2304,
      "items": { "$ref": "#/$defs/sourceFact" }
    },
    "beats": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/beat" }
    },
    "adaptationDecisions": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/adaptationDecision" }
    }
  },
  "$comment": "Runtime rebuilds the current approved extraction, source evidence and adaptation input before returning this read-only distinction view. Dynamic reference, order, duration and classification bindings remain runtime invariants.",
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "reviewRef": { "type": "string", "pattern": "^review:v1:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "factRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "decisionRefs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "durationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetSeconds", "toleranceSeconds", "totalSeconds"],
      "properties": {
        "targetSeconds": { "type": "integer", "minimum": 45, "maximum": 75 },
        "toleranceSeconds": { "type": "integer", "minimum": 0, "maximum": 15 },
        "totalSeconds": { "type": "integer", "minimum": 45, "maximum": 75 }
      }
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "factType", "factId", "factLabel", "factSummary", "factSha256"],
      "properties": {
        "classification": { "const": "source_fact" },
        "factType": { "enum": ["character", "scene", "prop", "relationship", "event", "dialogue"] },
        "factId": { "$ref": "#/$defs/identifier" },
        "factLabel": { "type": "string", "minLength": 1, "maxLength": 1100 },
        "factSummary": { "$ref": "#/$defs/summary" },
        "factSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beatId", "kind", "summary", "classification", "inferenceRationale",
        "estimatedDurationSeconds", "factRefs", "adaptationDecisionRefs"
      ],
      "properties": {
        "beatId": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["hook", "setup", "escalation", "climax", "cliffhanger"] },
        "summary": { "$ref": "#/$defs/summary" },
        "classification": { "enum": ["fact", "inference", "adaptation"] },
        "inferenceRationale": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 2000 },
            { "type": "null" }
          ]
        },
        "estimatedDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "factRefs": { "$ref": "#/$defs/factRefs" },
        "adaptationDecisionRefs": { "$ref": "#/$defs/decisionRefs" }
      }
    },
    "adaptationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "classification", "category", "summary", "rationale", "factRefs"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/identifier" },
        "classification": { "const": "adaptation" },
        "category": {
          "enum": ["invented-event", "compressed-timeline", "merged-character", "changed-setting", "added-dialogue", "other"]
        },
        "summary": { "$ref": "#/$defs/summary" },
        "rationale": { "$ref": "#/$defs/summary" },
        "factRefs": {
          "allOf": [
            { "$ref": "#/$defs/factRefs" },
            { "type": "array", "minItems": 1 }
          ]
        }
      }
    }
  }
}
