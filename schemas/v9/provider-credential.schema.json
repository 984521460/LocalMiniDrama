{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v9/provider-credential.schema.json",
  "title": "Secret-free provider credential result",
  "$comment": "This public contract never contains the credential secret. The ref is an opaque Windows Credential Manager reference and does not prove that a provider request succeeded.",
  "oneOf": [
    { "$ref": "#/$defs/descriptor" },
    { "$ref": "#/$defs/removal" },
    { "$ref": "#/$defs/cleanup" }
  ],
  "$defs": {
    "credentialRef": {
      "type": "string",
      "pattern": "^credential:v1:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "ref", "kind", "configured"],
      "properties": {
        "schemaVersion": { "const": "provider-credential.v1" },
        "ref": { "$ref": "#/$defs/credentialRef" },
        "kind": { "enum": ["api_key", "provider_token"] },
        "configured": { "const": true }
      }
    },
    "removal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "ref", "removed"],
      "properties": {
        "schemaVersion": { "const": "provider-credential-removal.v1" },
        "ref": { "$ref": "#/$defs/credentialRef" },
        "removed": { "const": true }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "ref", "cleanupRequired"],
      "properties": {
        "schemaVersion": { "const": "provider-credential-cleanup.v1" },
        "ref": { "$ref": "#/$defs/credentialRef" },
        "cleanupRequired": { "const": true }
      }
    }
  }
}
