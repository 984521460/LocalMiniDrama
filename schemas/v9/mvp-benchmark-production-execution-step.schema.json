{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v9/mvp-benchmark-production-execution-step.schema.json",
  "title": "MVP Benchmark Production Execution Step",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationUid",
    "sessionUid",
    "dramaUid",
    "batchSha256",
    "completedCount",
    "totalCount",
    "batchComplete",
    "item"
  ],
  "properties": {
    "schemaVersion": { "const": "mvp-benchmark-production-execution-step.v1" },
    "authorizationUid": { "$ref": "#/$defs/uuid" },
    "sessionUid": { "$ref": "#/$defs/uuid" },
    "dramaUid": { "$ref": "#/$defs/uuid" },
    "batchSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completedCount": { "type": "integer", "minimum": 1, "maximum": 64 },
    "totalCount": { "type": "integer", "minimum": 2, "maximum": 64 },
    "batchComplete": { "type": "boolean" },
    "item": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ordinal", "itemKind", "itemUid", "status"],
          "properties": {
            "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
            "itemKind": { "enum": ["h3", "tts"] },
            "itemUid": { "$ref": "#/$defs/uuid" },
            "status": { "const": "succeeded" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "batchComplete": { "const": true } } },
      "then": { "properties": { "item": { "type": "null" } } },
      "else": { "properties": { "item": { "type": "object" } } }
    }
  ],
  "$comment": "Runtime additionally binds batchSha256 to the frozen preflight batch, enforces completedCount <= totalCount, batchComplete iff the counts are equal, and a non-null item ordinal of completedCount - 1.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
