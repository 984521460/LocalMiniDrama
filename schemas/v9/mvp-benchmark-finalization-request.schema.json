{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v9/mvp-benchmark-finalization-request.schema.json",
  "title": "MVP benchmark finalization request",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "expectedBatchSha256", "bgmTrackUid"],
      "properties": {
        "schemaVersion": { "const": "mvp-benchmark-finalization-request.v1" },
        "expectedBatchSha256": { "$ref": "#/$defs/sha256" },
        "bgmTrackUid": { "$ref": "#/$defs/uid" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "expectedBatchSha256", "bgmTrackUid", "shotTaskOrder"],
      "properties": {
        "schemaVersion": { "const": "mvp-benchmark-finalization-request.v2" },
        "expectedBatchSha256": { "$ref": "#/$defs/sha256" },
        "bgmTrackUid": { "$ref": "#/$defs/uid" },
        "shotTaskOrder": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uid" }
        }
      }
    }
  ]
}
