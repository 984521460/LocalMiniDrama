{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v9/mvp-benchmark-operator-attestation.schema.json",
  "title": "MVP Benchmark Operator Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "licenseId",
    "licenseSourceRevision",
    "requiredEnvironmentSha256",
    "territoryEligibilityConfirmed",
    "commercialEligibilityBasis",
    "commercialUiAttributionAccepted",
    "acceptableUseAndSafeguardsAccepted",
    "downstreamUseRestrictionsAccepted",
    "publicAiContentDisclosureAccepted",
    "benchmarkInputRightsConfirmed",
    "attestationSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "mvp-benchmark-operator-attestation.v1" },
    "licenseId": { "const": "MiniMax-H3-Community-License-Agreement" },
    "licenseSourceRevision": { "const": "42ed227ee7df40d41602854ae760620d6eb651fe" },
    "requiredEnvironmentSha256": { "const": "716b53e4b0cc4bb2a732e16ff0722e5313bc9ecef28cb6950be092b4fd852d43" },
    "territoryEligibilityConfirmed": { "const": true },
    "commercialEligibilityBasis": {
      "enum": [
        "annual-revenue-not-over-usd-20000000",
        "written-minimax-authorization"
      ]
    },
    "commercialUiAttributionAccepted": { "const": true },
    "acceptableUseAndSafeguardsAccepted": { "const": true },
    "downstreamUseRestrictionsAccepted": { "const": true },
    "publicAiContentDisclosureAccepted": { "const": true },
    "benchmarkInputRightsConfirmed": { "const": true },
    "attestationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
