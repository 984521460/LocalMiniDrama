{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationUid",
    "dramaUid",
    "characterUid",
    "requestedCount",
    "receivedCount",
    "state",
    "sourceCurrent",
    "bindingState",
    "recoveryEnabled",
    "batchReady",
    "canRecover",
    "connectionCurrent",
    "quarantineStatus",
    "jobs",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "character-candidate-recovery.v1"
    },
    "operationUid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dramaUid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "characterUid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "requestedCount": {
      "const": 4
    },
    "receivedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "state": {
      "enum": [
        "collected",
        "partial",
        "recoverable",
        "submission_unknown"
      ]
    },
    "sourceCurrent": {
      "type": "boolean"
    },
    "bindingState": {"enum":["bound","needs_rebind"]},
    "recoveryEnabled": {
      "type": "boolean"
    },
    "batchReady": {
      "type": "boolean"
    },
    "canRecover": {
      "type": "boolean"
    },
    "connectionCurrent": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "quarantineStatus": {
      "const": "unapproved"
    },
    "jobs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "state"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "state": {
            "enum": [
              "not_submitted",
              "submitting",
              "submitted",
              "output_bound",
              "collected"
            ]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "assetUid",
          "assetVersionUid",
          "logicalUri",
          "relativePath",
          "contentSha256",
          "byteLength",
          "width",
          "height"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "assetUid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "assetVersionUid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "logicalUri": {
            "type": "string",
            "pattern": "^asset://characters/"
          },
          "relativePath": {
            "type": "string",
            "pattern": "^characters/"
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "width": {
            "type": "integer",
            "minimum": 256,
            "maximum": 2048
          },
          "height": {
            "type": "integer",
            "minimum": 256,
            "maximum": 2048
          }
        }
      }
    }
  }
}
