{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v7/h3-real-validation-matrix.schema.json",
  "title": "MiniMax H3 real GPU validation matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileUid", "gpus"],
  "properties": {
    "schemaVersion": { "const": "h3-real-validation-matrix.v1" },
    "profileUid": { "$ref": "#/$defs/uid" },
    "gpus": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/gpu" },
            {
              "type": "object",
              "properties": {
                "gpuClass": { "const": "rtx4090-24gb" },
                "vramGiB": { "const": 24 },
                "modes": {
                  "type": "object",
                  "properties": {
                    "t2v": { "$ref": "#/$defs/verifiedRtx4090T2v" },
                    "fl2va-first": { "$ref": "#/$defs/verifiedRtx4090Fl2vaFirst" },
                    "fl2va-first-last": { "$ref": "#/$defs/verifiedRtx4090Fl2vaFirstLast" },
                    "ref2va": { "$ref": "#/$defs/verifiedRtx4090Ref2va" }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gpu" },
            {
              "type": "object",
              "properties": {
                "gpuClass": { "const": "rtx-pro-6000-blackwell-96gb" },
                "vramGiB": { "const": 96 },
                "modes": {
                  "type": "object",
                  "properties": {
                    "t2v": { "$ref": "#/$defs/unverifiedMode" },
                    "fl2va-first": { "$ref": "#/$defs/unverifiedMode" },
                    "fl2va-first-last": { "$ref": "#/$defs/unverifiedMode" },
                    "ref2va": { "$ref": "#/$defs/unverifiedMode" }
                  }
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "uid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "requestedSeconds", "width", "height", "fps", "frames", "videoCodec", "audioCodec", "outputSha256", "evidenceRef"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
        "requestedSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 15 },
        "width": { "type": "integer", "minimum": 32, "maximum": 1344 },
        "height": { "type": "integer", "minimum": 32, "maximum": 1344 },
        "fps": { "const": 24 },
        "frames": { "type": "integer", "minimum": 5, "maximum": 362 },
        "videoCodec": { "const": "h264" },
        "audioCodec": { "const": "aac" },
        "outputSha256": { "$ref": "#/$defs/sha256" },
        "evidenceRef": { "type": "string", "pattern": "^phase-(?:1|7):[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "measuredCases"],
      "properties": {
        "status": { "enum": ["verified", "unverified"] },
        "measuredCases": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/case" } }
      }
    },
    "verifiedMode": {
      "allOf": [
        { "$ref": "#/$defs/mode" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "verified" },
            "measuredCases": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    "verifiedRtx4090T2v": {
      "allOf": [
        { "$ref": "#/$defs/verifiedMode" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "verified" },
            "measuredCases": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "allOf": [
                    { "$ref": "#/$defs/case" },
                    {
                      "type": "object",
                      "properties": {
                        "caseId": { "const": "h3-client-smoke" },
                        "requestedSeconds": { "const": 0.2 },
                        "width": { "const": 608 },
                        "height": { "const": 352 },
                        "fps": { "const": 24 },
                        "frames": { "const": 5 },
                        "videoCodec": { "const": "h264" },
                        "audioCodec": { "const": "aac" },
                        "outputSha256": { "const": "d8d9af12a1ea45fe054308dd83ad7183421471fd3fbb534b54f7e10c425e29cf" },
                        "evidenceRef": { "const": "phase-1:h3-client-smoke" }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    { "$ref": "#/$defs/case" },
                    {
                      "type": "object",
                      "properties": {
                        "caseId": { "const": "h3-fight-15s" },
                        "requestedSeconds": { "const": 15 },
                        "width": { "const": 608 },
                        "height": { "const": 352 },
                        "fps": { "const": 24 },
                        "frames": { "const": 362 },
                        "videoCodec": { "const": "h264" },
                        "audioCodec": { "const": "aac" },
                        "outputSha256": { "const": "4fc449c09f34efbe7955e056f4108ae36c469097f70e93480996f0a8fadd8ecf" },
                        "evidenceRef": { "const": "phase-1:h3-fight-15s" }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    { "$ref": "#/$defs/case" },
                    {
                      "type": "object",
                      "properties": {
                        "caseId": { "const": "h3-real-t2v" },
                        "requestedSeconds": { "const": 1.625 },
                        "width": { "const": 608 },
                        "height": { "const": 352 },
                        "fps": { "const": 24 },
                        "frames": { "const": 39 },
                        "videoCodec": { "const": "h264" },
                        "audioCodec": { "const": "aac" },
                        "outputSha256": { "const": "49aa825a1f8c20e5c3a71038ec795aa28ec2fab3e07a14eb316ee632f462f525" },
                        "evidenceRef": { "const": "phase-7:h3-real-t2v" }
                      }
                    }
                  ]
                }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "verifiedRtx4090Fl2vaFirst": {
      "allOf": [
        { "$ref": "#/$defs/verifiedMode" },
        {
          "type": "object",
          "properties": {
            "measuredCases": {
              "type": "array", "minItems": 1, "maxItems": 1, "items": false,
              "prefixItems": [{
                "allOf": [
                  { "$ref": "#/$defs/case" },
                  { "type": "object", "properties": {
                    "caseId": { "const": "h3-real-fl2va-first" },
                    "requestedSeconds": { "const": 1.625 }, "width": { "const": 608 },
                    "height": { "const": 352 }, "fps": { "const": 24 },
                    "frames": { "const": 39 }, "videoCodec": { "const": "h264" },
                    "audioCodec": { "const": "aac" },
                    "outputSha256": { "const": "63cb57efe4cb466c3ce8b479a1239aff510baa63891959cabf1bdcf4b94e8f9a" },
                    "evidenceRef": { "const": "phase-7:h3-real-fl2va-first" }
                  } }
                ]
              }]
            }
          }
        }
      ]
    },
    "verifiedRtx4090Fl2vaFirstLast": {
      "allOf": [
        { "$ref": "#/$defs/verifiedMode" },
        {
          "type": "object",
          "properties": {
            "measuredCases": {
              "type": "array", "minItems": 1, "maxItems": 1, "items": false,
              "prefixItems": [{
                "allOf": [
                  { "$ref": "#/$defs/case" },
                  { "type": "object", "properties": {
                    "caseId": { "const": "h3-real-fl2va-first-last" },
                    "requestedSeconds": { "const": 1.625 }, "width": { "const": 608 },
                    "height": { "const": 352 }, "fps": { "const": 24 },
                    "frames": { "const": 39 }, "videoCodec": { "const": "h264" },
                    "audioCodec": { "const": "aac" },
                    "outputSha256": { "const": "d65c380d207d5a35ef484af2135b0fbbac0df95230f00f4cad53efd4272537ae" },
                    "evidenceRef": { "const": "phase-7:h3-real-fl2va-first-last" }
                  } }
                ]
              }]
            }
          }
        }
      ]
    },
    "verifiedRtx4090Ref2va": {
      "allOf": [
        { "$ref": "#/$defs/verifiedMode" },
        {
          "type": "object",
          "properties": {
            "measuredCases": {
              "type": "array", "minItems": 1, "maxItems": 1, "items": false,
              "prefixItems": [{
                "allOf": [
                  { "$ref": "#/$defs/case" },
                  { "type": "object", "properties": {
                    "caseId": { "const": "h3-real-ref2va" },
                    "requestedSeconds": { "const": 1.625 }, "width": { "const": 608 },
                    "height": { "const": 352 }, "fps": { "const": 24 },
                    "frames": { "const": 39 }, "videoCodec": { "const": "h264" },
                    "audioCodec": { "const": "aac" },
                    "outputSha256": { "const": "7fa3e5f46c95a06c6f144afd4663425c1a1af2c2a5f28974f4fb7baab86d3033" },
                    "evidenceRef": { "const": "phase-7:h3-real-ref2va" }
                  } }
                ]
              }]
            }
          }
        }
      ]
    },
    "unverifiedMode": {
      "allOf": [
        { "$ref": "#/$defs/mode" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "unverified" },
            "measuredCases": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpuClass", "vramGiB", "modes"],
      "properties": {
        "gpuClass": { "enum": ["rtx4090-24gb", "rtx-pro-6000-blackwell-96gb"] },
        "vramGiB": { "enum": [24, 96] },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["t2v", "fl2va-first", "fl2va-first-last", "ref2va"],
          "properties": {
            "t2v": { "$ref": "#/$defs/mode" },
            "fl2va-first": { "$ref": "#/$defs/mode" },
            "fl2va-first-last": { "$ref": "#/$defs/mode" },
            "ref2va": { "$ref": "#/$defs/mode" }
          }
        }
      }
    }
  }
}
