{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mini-drama.invalid/schemas/v3/novel-extraction.schema.json",
  "title": "NovelExtractionTask output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "characters",
    "scenes",
    "props",
    "relationships",
    "events",
    "dialogue"
  ],
  "properties": {
    "schemaVersion": { "const": "novel-extraction.v1" },
    "characters": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/characterFact" }
    },
    "scenes": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/sceneFact" }
    },
    "props": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/propFact" }
    },
    "relationships": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/relationshipFact" }
    },
    "events": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/eventFact" }
    },
    "dialogue": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/dialogueFact" }
    }
  },
  "$defs": {
    "factId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockUid", "startOffset", "endOffset", "quote"],
      "properties": {
        "blockUid": { "$ref": "#/$defs/uid" },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 1 },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "characterFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "name", "description", "evidence"],
      "properties": {
        "factId": { "$ref": "#/$defs/factId" },
        "name": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/description" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "sceneFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "location", "time", "description", "evidence"],
      "properties": {
        "factId": { "$ref": "#/$defs/factId" },
        "location": { "$ref": "#/$defs/shortText" },
        "time": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/description" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "propFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "name", "description", "evidence"],
      "properties": {
        "factId": { "$ref": "#/$defs/factId" },
        "name": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/description" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "relationshipFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "fromCharacterFactId", "toCharacterFactId", "relationship", "evidence"],
      "properties": {
        "factId": { "$ref": "#/$defs/factId" },
        "fromCharacterFactId": { "$ref": "#/$defs/factId" },
        "toCharacterFactId": { "$ref": "#/$defs/factId" },
        "relationship": { "$ref": "#/$defs/description" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "eventFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "summary", "characterFactIds", "sceneFactId", "propFactIds", "evidence"],
      "properties": {
        "factId": { "$ref": "#/$defs/factId" },
        "summary": { "$ref": "#/$defs/description" },
        "characterFactIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/factId" }
        },
        "sceneFactId": {
          "oneOf": [
            { "$ref": "#/$defs/factId" },
            { "type": "null" }
          ]
        },
        "propFactIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/factId" }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "dialogueFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "speakerCharacterFactId", "content", "evidence"],
      "properties": {
        "factId": { "$ref": "#/$defs/factId" },
        "speakerCharacterFactId": {
          "oneOf": [
            { "$ref": "#/$defs/factId" },
            { "type": "null" }
          ]
        },
        "content": { "$ref": "#/$defs/description" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
